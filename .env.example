# GEMINI_API_KEY: Optional - server-side proxy only. Never expose to client-side code.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Supabase + PostgreSQL Database Configuration
# Obtain these from Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Phone OTP & Messaging Provisioning (Disabled by default)
VITE_OTP_ENABLED="false"
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_OTP_TEMPLATE_ID="your-otp-template-id"
MSG91_SENDER_ID="URBNCR"
WHATSAPP_PROVIDER="gupshup"

# Supabase Edge Functions Configuration
ALLOWED_ORIGIN="https://urbancaresolution.in"

# Google Maps Platform Configuration
# Required APIs enabled in Google Cloud Console:
# 1. Maps JavaScript API
# 2. Places API (or Places API New)
# 3. Geocoding API
# Security Recommendation: Restrict browser API key to HTTP referrers:
# - https://urbancaresolution.in/*
# - http://localhost:3000/*
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"
